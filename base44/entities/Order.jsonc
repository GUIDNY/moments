{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "customer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "tshirt",
        "hoodie",
        "cap",
        "mug"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "product_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "size": {
      "type": "string",
      "description": "\u05de\u05d9\u05d3\u05d4"
    },
    "quantity": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8"
    },
    "design_image_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05e2\u05d9\u05e6\u05d5\u05d1 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea (\u05dc\u05dc\u05d0 \u05d8\u05e7\u05e1\u05d8)"
    },
    "design_with_text_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d5\u05e7\u05d0\u05e4 \u05db\u05d5\u05dc\u05dc \u05d8\u05e7\u05e1\u05d8"
    },
    "graphic_with_text_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d2\u05e8\u05e4\u05d9\u05e7\u05d4 \u05e2\u05dd \u05d8\u05e7\u05e1\u05d8 \u05dc\u05d4\u05d3\u05e4\u05e1\u05d4 (\u05dc\u05dc\u05d0 \u05de\u05d5\u05e7\u05d0\u05e4)"
    },
    "mockup_image_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d5\u05e7\u05d0\u05e4"
    },
    "overlay_text": {
      "type": "string",
      "description": "\u05d4\u05d8\u05e7\u05e1\u05d8 \u05e9\u05d4\u05ea\u05d5\u05d5\u05e1\u05e3 \u05dc\u05e2\u05d9\u05e6\u05d5\u05d1"
    },
    "shirt_color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent_to_supplier",
        "in_production",
        "shipped",
        "delivered"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d4\u05d6\u05de\u05e0\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "customer_email",
    "product_type",
    "product_name",
    "size",
    "quantity",
    "price",
    "design_image_url"
  ]
}