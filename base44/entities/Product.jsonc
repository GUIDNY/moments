{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d1\u05e9\u05e7\u05dc\u05d9\u05dd"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "video_url": {
      "type": "string",
      "description": "\u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "design_image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1 \u05de\u05d5\u05ea\u05d0\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea"
    },
    "category": {
      "type": "string",
      "enum": [
        "sport",
        "politics",
        "viral",
        "reality"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "tshirt",
        "hoodie",
        "cap",
        "mug"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05de\u05d5\u05e6\u05e8"
    },
    "event_date": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "drop_ends": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd \u05d4\u05d3\u05e8\u05d5\u05e4"
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "sold_out"
      ],
      "default": "in_stock",
      "description": "\u05de\u05e6\u05d1 \u05de\u05dc\u05d0\u05d9"
    },
    "is_trending": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d8\u05e8\u05e0\u05d3\u05d9 \u05db\u05e8\u05d2\u05e2"
    },
    "show_on_homepage": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d1\u05d3\u05e3 \u05d4\u05d1\u05d9\u05ea"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d9\u05d3\u05d5\u05ea \u05d6\u05de\u05d9\u05e0\u05d5\u05ea"
    }
  },
  "required": [
    "name",
    "price",
    "category",
    "product_type"
  ]
}